# Server-side only — used by frontend/src/lib/api/config.ts
# The TanStack Start server functions read this. Do NOT prefix with VITE_.
# VITE_-prefixed vars get bundled into the browser, which would leak the
# backend URL. RUST_API_BASE_URL stays in process.env and is only read inside
# createServerFn server functions.
RUST_API_BASE_URL=http://127.0.0.1:3000
