# 로컬 개발 (docker compose up -d 로 postgres/valkey만 실행한 경우)
DATABASE_URL=postgres://postgres:postgrespassword@127.0.0.1:5433/playground
# DB 커넥션 풀 (미설정 시 db.rs 기본값 사용)
# DB_POOL_MAX_CONNECTIONS=10
# DB_POOL_MIN_CONNECTIONS=1
# DB_POOL_CONNECT_TIMEOUT_SECS=10
# DB_POOL_ACQUIRE_TIMEOUT_SECS=10
# DB_POOL_IDLE_TIMEOUT_SECS=600
# DB_POOL_MAX_LIFETIME_SECS=1800
# 데드락·락 타임아웃 (PostgreSQL 세션, 미설정 시 db.rs 기본값 사용)
# DB_LOCK_TIMEOUT_SECS=5
# DB_STATEMENT_TIMEOUT_SECS=30
# DB_IDLE_IN_TRANSACTION_TIMEOUT_SECS=60
# DB_DEADLOCK_TIMEOUT_MS=1000
VALKEY_URL=redis://127.0.0.1:6379

HOST=127.0.0.1
PORT=3000

# 선택: tracing 필터 (미설정 시 main.rs 기본값 사용)
# RUST_LOG=rust_backend_playground=debug,tower_http=debug,axum::rejection=trace
